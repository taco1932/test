attribute "fs_serializer";

namespace VfxEditor.Flatbuffer;

enum model_category_t:ushort {
    Invalid = 0xFFFF,
    Human = 0,
    DemiHuman = 1,
    Monster = 2,
    Weapon = 3,
}

enum model_id_t:uint {
    Invalid = 0,
    Sword = 201,
    Axe = 401,
    Bow = 601,
    Staff_THM_A = 801,
    Staff_THM_B = 821,
    Staff_THM_C = 831,
    Staff_CNJ_A = 1001,
    Staff_CNJ_B = 1028,
    Staff_CNJ_C = 1033,
    Broadsword = 1501,
    Book_A = 1701,
    Book_B = 1730,
    Book_C = 1736,
    Book_D = 1752,
    Book_E = 1753,
    Daggers = 1801,
    Daggers_Offhand = 1851,
    Orrery = 2101,
    Katana_A = 2201,
    Katana_B = 2215,
    Katana_Sheathe_A = 2251,
    Katana_Sheathe_B = 2259,
    Glaives = 2611,
    Glaives_Off = 2661,
    Scythe = 2816,
    Cross_Pein_Hammer = 5103,
    Knife = 5405,
    Needle = 5503,
    Pickaxe = 7004,
    Fishing_Rod = 7202,
}

table alpha_t {
    alpha_0: uint; // refers to w0001bXXXX subweapon/part ID
    alpha_1: [ushort]; // extra data?
    alpha_2: bool; // whether or not a skeleton is attached?
}

table model_t {
    id: model_id_t; // refers to wXXXX identifiers for equippable weps
    category: model_category_t; // cool that other types can use this but only weapons do rn
    alpha: [alpha_t]; // parts for each weapon
}

table ESLB {
    eslb_0: uint; // unknown/not present
    eslb_1: uint; // unknown/not present
    model_array: [model_t];
}

file_identifier "ESLB";
root_type EslbData;